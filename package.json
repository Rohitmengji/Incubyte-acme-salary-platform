{
  "name": "acme-salary-platform",
  "private": true,
  "description": "Salary management platform for ACME HR (Incubyte assessment)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "setup": "npm run setup -w @acme/api",
    "dev": "npm run db:start && concurrently --kill-others-on-fail --names api,web --prefix-colors cyan,magenta \"npm run dev:api -w @acme/api\" \"npm run dev -w @acme/web\"",
    "build": "npm run build -w @acme/api && npm run build -w @acme/web",
    "db:start": "npm run db:start -w @acme/api",
    "db:stop": "npm run db:stop -w @acme/api",
    "db:reset": "npm run db:reset -w @acme/api",
    "db:seed": "npm run db:seed -w @acme/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration -w @acme/api",
    "start": "concurrently --kill-others --names api,web --prefix-colors cyan,magenta \"npm run start -w @acme/api\" \"npm run start -w @acme/web\"",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "esbuild": true,
    "prisma": true,
    "@prisma/engines": true,
    "@embedded-postgres/darwin-arm64": true,
    "@embedded-postgres/darwin-x64": true,
    "@embedded-postgres/linux-x64": true,
    "@embedded-postgres/linux-arm64": true,
    "@embedded-postgres/windows-x64": true,
    "fsevents": false
  }
}
