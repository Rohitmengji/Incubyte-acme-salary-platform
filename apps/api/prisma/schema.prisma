// ACME Salary Management Platform: data model. See docs/architecture.md §5.
// Integrity rules Prisma cannot express (exclusion constraint, CHECKs, append-only audit trigger)
// live in custom SQL inside prisma/migrations and are guarded by test/integration/db-guards.test.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE

  @@map("employee_status")
}

enum CompensationReason {
  NEW_HIRE
  ANNUAL_REVIEW
  PROMOTION
  MARKET_ADJUSTMENT
  ROLE_CHANGE
  CORRECTION
  OTHER

  @@map("compensation_reason")
}

enum UserRole {
  HR_MANAGER
  HR_VIEWER

  @@map("user_role")
}

model Currency {
  code       String @id @db.Char(3)
  name       String @db.VarChar(64)
  minorUnits Int    @map("minor_units") @db.SmallInt

  countries     Country[]
  compensations Compensation[]
  exchangeRates ExchangeRate[]

  @@map("currency")
}

model Country {
  code                String @id @db.Char(2)
  name                String @unique @db.VarChar(100)
  defaultCurrencyCode String @map("default_currency_code") @db.Char(3)

  defaultCurrency Currency   @relation(fields: [defaultCurrencyCode], references: [code], onDelete: Restrict)
  employees       Employee[]

  @@map("country")
}

model Department {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(100)

  employees Employee[]

  @@map("department")
}

model JobTitle {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(100)

  employees Employee[]

  @@map("job_title")
}

model Employee {
  id              String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  employeeCode    String         @unique @map("employee_code") @db.VarChar(20)
  firstName       String         @map("first_name") @db.VarChar(100)
  lastName        String         @map("last_name") @db.VarChar(100)
  email           String         @unique @db.VarChar(254)
  countryCode     String         @map("country_code") @db.Char(2)
  departmentId    Int            @map("department_id")
  jobTitleId      Int            @map("job_title_id")
  status          EmployeeStatus @default(ACTIVE)
  hireDate        DateTime       @map("hire_date") @db.Date
  terminationDate DateTime?      @map("termination_date") @db.Date
  version         Int            @default(1)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  country       Country        @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  department    Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  jobTitle      JobTitle       @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  compensations Compensation[]
  auditEvents   AuditLog[]

  @@index([countryCode])
  @@index([departmentId])
  @@index([jobTitleId])
  @@index([status])
  @@index([lastName, firstName, id])
  @@index([hireDate, id])
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "employee_first_name_trgm_idx")
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "employee_last_name_trgm_idx")
  @@index([employeeCode(ops: raw("gin_trgm_ops"))], type: Gin, map: "employee_code_trgm_idx")
  @@map("employee")
}

/// One salary period [effectiveFrom, effectiveTo). effectiveTo NULL = open-ended. ADR-0003.
model Compensation {
  id            String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  employeeId    String             @map("employee_id") @db.Uuid
  amount        Decimal            @db.Decimal(19, 4)
  currencyCode  String             @map("currency_code") @db.Char(3)
  effectiveFrom DateTime           @map("effective_from") @db.Date
  effectiveTo   DateTime?          @map("effective_to") @db.Date
  reason        CompensationReason
  note          String?            @db.VarChar(500)
  createdById   String?            @map("created_by_id") @db.Uuid
  version       Int                @default(1)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  currency  Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  createdBy AppUser? @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([employeeId, effectiveFrom])
  @@index([currencyCode])
  @@map("compensation")
}

/// Illustrative, dated FX snapshot for normalised reporting only (ADR-0002).
model ExchangeRate {
  id              Int      @id @default(autoincrement())
  currencyCode    String   @map("currency_code") @db.Char(3)
  rateToReporting Decimal  @map("rate_to_reporting") @db.Decimal(20, 10)
  asOfDate        DateTime @map("as_of_date") @db.Date
  source          String   @db.VarChar(200)

  currency Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  @@unique([currencyCode, asOfDate])
  @@map("exchange_rate")
}

model AppUser {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String    @unique @db.VarChar(254)
  displayName  String    @map("display_name") @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions      Session[]
  auditEvents   AuditLog[]
  compensations Compensation[]

  @@map("app_user")
}

model Session {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// SHA-256 (hex) of the opaque cookie token; the token itself is never stored.
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

/// Append-only: a trigger rejects UPDATE and DELETE. Written in the same transaction as the change.
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(64)
  entityType  String   @map("entity_type") @db.VarChar(32)
  entityId    String   @map("entity_id") @db.Uuid
  employeeId  String?  @map("employee_id") @db.Uuid
  changes     Json
  requestId   String?  @map("request_id") @db.VarChar(64)

  actor    AppUser?  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, occurredAt(sort: Desc)])
  @@index([entityType, occurredAt(sort: Desc)])
  @@map("audit_log")
}
