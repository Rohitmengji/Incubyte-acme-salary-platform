# Copied to .env by `npm run setup` when .env does not exist. Values below are for local development only.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local embedded PostgreSQL (see scripts/db.mjs). Set EMBEDDED_POSTGRES=0 to use your own server instead.
EMBEDDED_POSTGRES=1
DATABASE_URL=postgresql://acme:acme_local_dev@localhost:54329/acme_dev
TEST_DATABASE_URL=postgresql://acme:acme_local_dev@localhost:54329/acme_test

# Browser origin(s) allowed to call the API (comma separated).
WEB_ORIGIN=http://localhost:3000
# Number of reverse-proxy hops in front of the API (the Next.js rewrite counts as one).
TRUST_PROXY_HOPS=1
SESSION_TTL_HOURS=8
# Secure cookies are forced on when NODE_ENV=production.
COOKIE_SECURE=false

# Demo users created by the seed. Local demo values only: set strong values in any shared environment.
SEED_MANAGER_PASSWORD=Manager-Demo-2026!
SEED_VIEWER_PASSWORD=Viewer-Demo-2026!
